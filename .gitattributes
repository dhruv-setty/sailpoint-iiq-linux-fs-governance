# Language statistics: IdentityIQ XML, BeanShell held in XML, JBoss CLI and
# property files are configuration, not the implementation language.
*.xml         linguist-detectable=false
*.properties  linguist-detectable=false
*.cli         linguist-detectable=false
*.bsh         linguist-detectable=false
*.md          linguist-documentation
docs/**       linguist-documentation
# Implementation languages: Java (Maven modules) and C# (src/OntapNfs).
*.java        linguist-language=Java
*.cs          linguist-language=C#
*.csproj      linguist-detectable=false
*.props       linguist-detectable=false
*.sln         linguist-detectable=false
*.sln         text eol=lf

* text=auto eol=lf
*.jar binary
