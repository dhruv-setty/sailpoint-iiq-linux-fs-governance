<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE Application PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  Authoritative HR source delivered as a delimited extract. The HR system
  drops a full file nightly; aggregation creates and updates identities and
  sets the manager hierarchy used by manager certifications and approvals.
-->
<Application authoritative="true" connector="sailpoint.connector.DelimitedFileConnector"
             featuresString="DIRECT_PERMISSIONS, NO_RANDOM_ACCESS, DISCOVER_SCHEMA"
             icon="enterpriseIcon" name="FSGov HR Authoritative" profileClass="" type="DelimitedFile">
  <Attributes>
    <Map>
      <entry key="file" value="%%HR_FEED_FILE%%"/>
      <entry key="filetransport" value="local"/>
      <entry key="filterEmptyRecords" value="true"/>
      <entry key="delimiter" value=","/>
      <entry key="hasHeader" value="true"/>
      <entry key="parseType" value="delimited"/>
      <entry key="mergeRows" value="false"/>
      <entry key="partitionMode" value="auto"/>
      <entry key="buildMapRule" value="FSGov-BuildMap-HR"/>
      <entry key="sysDescriptions">
        <value>
          <Map>
            <entry key="en_US" value="Authoritative HR extract for workers who use the legacy Linux file shares."/>
          </Map>
        </value>
      </entry>
    </Map>
  </Attributes>
  <CorrelationRule>
    <Reference class="sailpoint.object.Rule" name="FSGov-Correlation-HR"/>
  </CorrelationRule>
  <Owner>
    <Reference class="sailpoint.object.Identity" name="%%HR_APP_OWNER%%"/>
  </Owner>
  <Schemas>
    <Schema displayAttribute="displayName" identityAttribute="employeeId" instanceAttribute=""
            nativeObjectType="account" objectType="account">
      <AttributeDefinition name="employeeId" type="string">
        <Description>Immutable worker number. Correlation key.</Description>
      </AttributeDefinition>
      <AttributeDefinition name="displayName" type="string"/>
      <AttributeDefinition name="firstName" type="string"/>
      <AttributeDefinition name="lastName" type="string"/>
      <AttributeDefinition name="email" type="string"/>
      <AttributeDefinition name="department" type="string"/>
      <AttributeDefinition name="costCenter" type="string"/>
      <AttributeDefinition name="jobCode" type="string"/>
      <AttributeDefinition name="managerId" type="string">
        <Description>employeeId of the manager. Promoted to the manager identity attribute.</Description>
      </AttributeDefinition>
      <AttributeDefinition name="status" type="string">
        <Description>Normalised to active, leave or terminated by the build map rule.</Description>
      </AttributeDefinition>
      <AttributeDefinition name="linuxLogin" type="string">
        <Description>POSIX login name on the legacy hosts, used to correlate file system accounts.</Description>
      </AttributeDefinition>
      <AttributeDefinition name="workerType" type="string">
        <Description>employee, contractor or service.</Description>
      </AttributeDefinition>
    </Schema>
  </Schemas>
</Application>
