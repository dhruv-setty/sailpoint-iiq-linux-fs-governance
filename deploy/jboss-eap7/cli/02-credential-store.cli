# Creates the Elytron credential store that holds the database password and
# the Entra ID client secret. The store password is given in masked form
# produced by the elytron-tool utility; secrets come from a local properties
# file passed with --properties, which is never committed.
/subsystem=elytron/credential-store=iiq-store:add(path=iiq-store.cs, relative-to=jboss.server.config.dir, credential-reference={clear-text="${credential.store.masked.password}"}, create=true)
/subsystem=elytron/credential-store=iiq-store:add-alias(alias=iiq-db, secret-value="${iiq.db.password}")
/subsystem=elytron/credential-store=iiq-store:add-alias(alias=entra-client-secret, secret-value="${entra.client.secret}")
